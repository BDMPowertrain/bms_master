(version 1)
# PCBWay Custom DRC for KiCad 10 - EV27 BMS MASTER (BQ79600 daughterboard)
# 4 layers, 1 oz outer and 1 oz inner, 1.6 mm. Optimized for lowest cost.
# PCBWay limits: trace/space 0.1 mm (0.15 rec.), drill 0.2 mm min (under 0.2 costs more),
# copper to edge 0.3 mm.
#
# Net classes this file expects (set in Board Setup > Net Classes):
#   DAISY = chip side of U2/U3 (U1_COMH.*, U1_COML.*, COMH_W*, COMH_CT, COML_W*, COML_CT)
#           track 0.2 mm, diff pair width 0.2 / gap 0.2
#   ISO   = cable side of U2/U3 (COMH.P/N/CT, COML.P/N/CT) up to J4/J1
# Rule areas this file expects (draw on ALL copper layers):
#   DAISY_KO  around U1 pins 10-13 -> front-end parts -> U2/U3 pins 1-3
#   ISO_ZONE  around U2/U3 pins 4-6 -> J4/J1 (one per port, same name is fine)
#   In BOTH rule areas tick "Keep out copper pours" so the single GND zone is cut out there
#   (SLUSDS1A 10.1.1/10.1.4: no GND plane around the daisy-chain parts). The zone filler only
#   honours rule-area keepouts, not the custom rules below.

# ----------------------------------- Minimum trace width and spacing --------------------

# 1oz copper
(rule "Minimum Trace Width and Spacing (outer layer)"
(constraint track_width (min 0.15mm))
(constraint clearance (min 0.15mm))
(layer outer)
(condition "A.Type == 'track'"))

(rule "Minimum Trace Width and Spacing (inner layer)"
(constraint track_width (min 0.15mm))
(constraint clearance (min 0.15mm))
(layer inner)
(condition "A.Type == 'track'"))

# ------------------------------------------------------------------------------------------------------

# Drill/hole size - listed here to maintain order of rule application. Must not override rule set in Via hole/diameter size below.
(rule "drill hole size (mechanical)"
(constraint hole_size (min 0.2mm) (max 6.3mm)))

# ----------------------------------- Via hole/diameter size -------------------------------------------

# 0.2 mm drill / 0.5 mm pad = 0.15 mm ring per side, meets PCBWay
(rule "Minimum Via Diameter and Hole Size"
(constraint hole_size (min 0.2mm))
(constraint via_diameter (min 0.5mm))
(constraint annular_width (min 0.15mm))
(condition "A.Type == 'via'"))


# ----------------------------------- Drill/hole size --------------------------------------------------

(rule "PTH Hole Size"
(constraint hole_size (min 0.25mm) (max 6.35mm))
(condition "A.Type != 'Via' && A.isPlated()"))

(rule "Minimum Non-plated Hole Size"
(constraint hole_size (min 0.5mm))
(condition "A.Type == 'pad' && !A.isPlated()"))

(rule "Pad Size"
(constraint hole_size (min 0.25mm))
(constraint annular_width (min 0.15mm))
(condition "A.Type == 'Pad' && A.isPlated()"))

(rule "Min. Plated Slot Width"
(constraint hole_size (min 0.5mm))
(condition "(A.Hole_Size_X != A.Hole_Size_Y) && A.isPlated()"))

(rule "Min. Non-Plated Slot Width"
(constraint hole_size (min 0.8mm))
(condition "(A.Hole_Size_X != A.Hole_Size_Y) && !A.isPlated()"))


# ----------------------------------- Minimum clearance ------------------------------------------------

(rule "hole to hole clearance (different nets)"
(constraint hole_to_hole (min 0.5mm))
(condition "A.Net != B.Net"))

(rule "via to track clearance"
(constraint hole_clearance (min 0.254mm))
(condition "A.Type == 'via' && B.Type == 'track'"))

(rule "via to via clearance (same nets)"
(constraint hole_to_hole (min 0.254mm))
(condition "A.Type == 'via' && B.Type == A.Type && A.Net == B.Net"))

(rule "pad to pad clearance (with hole, different nets)"
(constraint hole_to_hole (min 0.5mm))
(condition "A.Type == 'pad' && B.Type == A.Type && A.Net != B.Net"))

(rule "pad to pad clearance (without hole, different nets)"
(constraint clearance (min 0.15mm))
(condition "A.Type == 'Pad' && B.Type == 'Pad'"))

(rule "NPTH to Track clearance"
(constraint hole_clearance (min 0.254mm))
(condition "A.Pad_Type == 'NPTH, mechanical' && B.Type == 'track'"))

(rule "NPTH with copper around"
(constraint hole_clearance (min 0.20mm))
(condition "A.Pad_Type == 'NPTH, mechanical' && B.Type != 'track'"))

(rule "PTH to Track clearance"
(constraint hole_clearance (min 0.33mm))
(constraint clearance (min 0.2mm))
(condition "A.isPlated() && A.Type != 'Via' && B.Type == 'track'"))

# ----------------------------------- Board Outlines ------------------------------------------------
# Default Routed Edge Clearance (no condition, so pours are pulled back too)
(rule "Trace to Outline"
(constraint edge_clearance (min 0.3mm)))

# ----------------------------------- Silkscreen ----------------------------------------------------
(rule "Minimum Text"
(constraint text_thickness (min 0.15mm))
(constraint text_height (min 0.8mm))
(layer "?.Silkscreen"))

(rule "Pad to Silkscreen"
(constraint silk_clearance (min 0.15mm))
(layer outer)
(condition "A.Type == 'pad' && (B.Type == 'text' || B.Type == 'graphic')"))

# ----------------------------------- Test Points / Fiducials Courtyard ------------------------------
(rule "Test Point Courtyard Exclusion"
(constraint courtyard_clearance (min -1mm))
(condition "A.Reference =='TP*'"))

(rule "Fiducial Courtyard Exclusion"
(constraint courtyard_clearance (min -1mm))
(condition "A.Reference =='FM*' || A.Reference =='FID*'"))

# ----------------------------------- Isolation (FSAE EV.7.5.7, 300-600 V, conformally coated) -------
# 3.0 mm clearance / 4.0 mm creepage under coating. Same-layer copper distance is the surface path,
# so 4.0 mm is used for both. Between layers is covered by the rule areas (no foreign copper on any
# layer inside DAISY_KO / ISO_ZONE).

# 1. Cable side of the transformers vs all GLV copper (tracks, pads, vias, GND zone)
(rule "ISO clearance"
(constraint clearance (min 4mm))
(constraint creepage (min 4mm))
(condition "A.NetClass == 'ISO' && B.NetClass != 'ISO'"))

# 2. COMH cable vs COML cable: in a fault they can sit at opposite ends of the stack (up to 537.6 V)
(rule "ISO COMH vs COML"
(constraint clearance (min 4mm))
(constraint creepage (min 4mm))
(condition "A.NetClass == 'ISO' && B.NetClass == 'ISO' && A.NetName == '*COMH*' && B.NetName == '*COML*'"))

# 3. ISO copper vs holes of other nets and mechanical holes (M3 steel screws, spacers, washers)
(rule "ISO to holes"
(constraint hole_clearance (min 4mm))
(condition "A.NetClass == 'ISO' && B.NetClass != 'ISO'"))

# 4. Optional: ISO copper to board edge (enable if the board edge sits near metal)
# (rule "ISO to edge"
# (constraint edge_clearance (min 4mm))
# (condition "A.NetClass == 'ISO'"))

# ----------------------------------- Keep Outs -------------------------------------------

# 5. Inside the daisy keep-out: only daisy nets, plus GND tracks/vias for the cap/TVS returns
(rule "DAISY_KO foreign copper"
(constraint disallow track via)
(condition "A.intersectsArea('DAISY_KO') && A.NetClass != 'DAISY' && A.NetClass != 'ISO' && A.NetName != 'GND'"))

# 6. Inside the cable-side zone: only ISO nets
(rule "ISO_ZONE foreign copper"
(constraint disallow track via)
(condition "A.intersectsArea('ISO_ZONE') && A.NetClass != 'ISO'"))

# ----------------------------------- Daisy Chain (SLUSDS1A 10.1.4 p.60) ------------------------------

# Layout: pair | gap | pair. 3W outside the pair: 0.2 mm trace -> 0.4 mm to anything else.
# Pads are excluded so tracks can leave pads at normal clearance.
# Relaxed inside U1's courtyard (BQ79600 TSSOP-16, 0.65 mm pitch) where 0.4 mm can't fit.
(rule "Daisy 3W spacing"
(constraint clearance (min 0.4mm))
(condition "A.Type == 'track' && A.NetClass == 'DAISY' && B.Type != 'Pad' && !A.intersectsCourtyard('U1')"))

# Inside the pair: P to N at the diff pair gap (must come after the 3W rule so it wins)
(rule "Daisy pair gap"
(constraint clearance (min 0.2mm))
(condition "A.NetClass == 'DAISY' && A.isCoupledDiffPair()"))

# Daisy pairs: P/N length matched (chip side and cable side)
(rule "Daisy skew"
(constraint skew (max 0.5mm) (within_diff_pairs))
(condition "A.inDiffPair('*COM*')"))